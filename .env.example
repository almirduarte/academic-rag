APP_NAME="Meu RAG"
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DIMENSIONS=768
# EMBEDDING_DEVICE=cuda
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=8

OLLAMA_URL=http://localhost:11434
# Modelo usado pelo piloto
OLLAMA_MODEL=qwen3:14b
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=900
OLLAMA_TIMEOUT_SECONDS=330

PGHOST=localhost
PGPORT=5432
PGDATABASE=academic_rag
PGUSER=postgres
PGPASSWORD=XXX

TOP_K=3
CHUNK_SIZE=1200
CHUNK_OVERLAP=150
    
RAG_API_TOKEN=XXX

FAROL_PUBLIC_URL=https://meu-dominio
SMTP_HOST=smtp.mail.host
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=nome-do-usuario
SMTP_PASSWORD='senha-do-usuario'
SMTP_FROM='Meu RAG <postmaster@meu-dominio>'
